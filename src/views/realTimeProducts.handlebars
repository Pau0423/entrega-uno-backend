<div class="container">

  <h1>🛒 Store</h1>

  <div class="card">
    <h2>Agregar producto</h2>

    <form id="formAdd">
      <input id="title" placeholder="Título" required />
      <input id="price" type="number" placeholder="Precio" required />
      <button type="submit">Agregar</button>
    </form>
  </div>

  <div class="card">
    <h2>Eliminar producto</h2>

    <form id="formDelete">
      <input id="productId" placeholder="ID producto (Mongo)" required />
      <button type="submit">Eliminar</button>
    </form>
  </div>

  <div class="card">
    <h2>Lista de productos</h2>

    <ul id="productList">
      {{#each products}}
        <li>
          ID:
          {{this._id}}
          -
          {{this.title}}
          - ${{this.price}}
        </li>
      {{/each}}
    </ul>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/realtime.js"></script>